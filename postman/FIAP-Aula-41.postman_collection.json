    {
      "name": "1 · Outbox: pedido e intenção no mesmo commit (slide 15)",
      "item": [
        {
          "name": "POST /pedidos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "description": "O service persiste Pedido e OutboxEvent no mesmo @Transactional. Guarda {{eventId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 42,\n  \"valor\": 150.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"eventId é UUID\", () => pm.expect(j.eventId).to.match(/^[0-9a-f-]{36}$/));",
                  "pm.test(\"enviado=false (relay ainda não rodou)\", () => pm.expect(j.enviado).to.eql(false));",
                  "pm.collectionVariables.set(\"eventId\", j.eventId);",
                  "pm.collectionVariables.set(\"pedidoId\", j.pedidoId);",
                  "console.log(\"eventId guardado:\", j.eventId);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /contagens → +1 pedido, +1 outbox",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contagens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contagens"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const antes = JSON.parse(pm.collectionVariables.get(\"antes\") || \"{}\");",
                  "const c = pm.response.json();",
                  "pm.test(\"pedidos: +1\", () => pm.expect(c.pedidos - (antes.pedidos||0)).to.eql(1));",
                  "pm.test(\"outbox: +1\", () => pm.expect(c.outbox - (antes.outbox||0)).to.eql(1));",
                  "pm.test(\"outboxPendentes: +1\", () => pm.expect(c.outboxPendentes - (antes.outboxPendentes||0)).to.eql(1));",
                  "pm.collectionVariables.set(\"antes\", JSON.stringify(c));"
                ]
              }
            }
          ]
        },
